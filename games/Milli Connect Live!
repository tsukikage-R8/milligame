<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Milli Connect - 演出強化＆赤スパ版</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"></script>
  <style>
    * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
    body {
      margin: 0; padding: 0; background-color: #0b0c1a; color: #fff;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      min-height: 100vh; overflow: hidden; touch-action: none;
    }

    #game-wrapper {
      position: relative; width: 100%; max-width: 400px; height: 100vh; max-height: 700px;
      display: flex; flex-direction: column; background: #12122b;
      box-shadow: 0 0 30px rgba(0,0,0,0.8); overflow: hidden;
    }

    .screen {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      transition: opacity 0.3s; z-index: 10; background: #12122b;
    }
    .hidden { opacity: 0; pointer-events: none; z-index: -1; }

    #title-screen h1 { font-size: 36px; color: #00f2fe; text-shadow: 0 0 15px #00f2fe; text-align: center; margin-bottom: 10px; }
    #title-screen p { color: #aaa; margin-bottom: 40px; font-size: 14px; }
    .play-btn {
      background: linear-gradient(45deg, #ff007f, #7928ca); border: none; color: white;
      padding: 15px 40px; font-size: 20px; font-weight: bold; border-radius: 40px; cursor: pointer;
      box-shadow: 0 5px 20px rgba(255,0,127,0.5); transition: transform 0.1s;
    }
    .play-btn:active { transform: scale(0.95); }

    #game-screen { z-index: 5; justify-content: flex-start; padding: 10px; }
    .header {
      width: 100%; display: flex; justify-content: space-between;
      background: rgba(255, 255, 255, 0.08); padding: 8px 15px; border-radius: 12px; margin-bottom: 8px;
    }
    .info-box { text-align: center; }
    .info-label { font-size: 10px; color: #aaa; letter-spacing: 1px; }
    .info-value { font-size: 20px; font-weight: 800; color: #00f2fe; }

    .gauges { width: 100%; display: flex; gap: 10px; margin-bottom: 10px; }
    .gauge-wrap { flex: 1; background: #2a2d5c; border-radius: 8px; height: 16px; position: relative; overflow: hidden; }
    .gauge-bar { height: 100%; transition: width 0.1s linear; }
    #fever-bar { background: linear-gradient(90deg, #ff007f, #ff8c00); width: 0%; }
    #combo-bar { background: linear-gradient(90deg, #00f2fe, #4facfe); width: 0%; }
    .gauge-text { position: absolute; top: 0; left: 8px; font-size: 10px; line-height: 16px; font-weight: bold; text-shadow: 1px 1px 2px #000; }

    #canvas-container {
      position: relative; width: 100%; flex: 1; min-height: 300px;
      background: radial-gradient(circle, #1a1c3b 0%, #0d0e21 100%);
      border-radius: 16px; border: 3px solid #2a2d5c; overflow: hidden; transition: background 0.3s, border-color 0.3s;
    }
    #canvas-container.fever-mode {
      background: radial-gradient(circle, #4a1c40 0%, #2d0e21 100%); border-color: #ff007f; box-shadow: inset 0 0 20px rgba(255,0,127,0.3);
    }
    
    /* 画面揺れアニメーション */
    .shake-small { animation: shake 0.3s cubic-bezier(.36,.07,.19,.97) both; }
    .shake-large { animation: shake-lg 0.5s cubic-bezier(.36,.07,.19,.97) both; }
    @keyframes shake {
      10%, 90% { transform: translate3d(-1px, 0, 0); }
      20%, 80% { transform: translate3d(2px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
      40%, 60% { transform: translate3d(4px, 0, 0); }
    }
    @keyframes shake-lg {
      10%, 90% { transform: translate3d(-3px, -3px, 0); }
      20%, 80% { transform: translate3d(5px, 5px, 0); }
      30%, 50%, 70% { transform: translate3d(-8px, 4px, 0); }
      40%, 60% { transform: translate3d(8px, -4px, 0); }
    }

    canvas { display: block; position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2; }
    
    #fx-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 3; pointer-events: none; overflow: hidden; }
    .comment { position: absolute; white-space: nowrap; font-weight: bold; color: rgba(255,255,255,0.8); font-size: 18px; animation: scrollL 3s linear forwards; text-shadow: 1px 1px 2px #000; }
    @keyframes scrollL { from { transform: translateX(100vw); } to { transform: translateX(-100%); } }
    
    #cutin {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0);
      font-size: 32px; font-weight: 900; color: #fff; text-shadow: 0 0 10px #ff007f, 2px 2px 0px #000;
      opacity: 0; transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); text-align: center;
    }

    .skills { width: 100%; display: flex; justify-content: space-around; padding: 15px 0 5px 0; }
    .skill-btn {
      width: 60px; height: 60px; border-radius: 50%; border: 3px solid #444; background: #222;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      position: relative; overflow: hidden; cursor: pointer; transition: 0.1s;
    }
    .skill-btn.ready { border-color: #00f2fe; background: #0f3460; box-shadow: 0 0 15px rgba(0,242,254,0.6); }
    .skill-btn:active { transform: scale(0.9); }
    .skill-fill { position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(0,242,254,0.3); transition: height 0.2s; z-index: 0; }
    .skill-text { z-index: 1; font-size: 10px; font-weight: bold; text-align: center; text-shadow: 1px 1px 2px #000; }

    #result-screen { background: rgba(11,12,26,0.95); backdrop-filter: blur(10px); }
    .result-box { background: #1a1c3b; padding: 25px; border-radius: 20px; width: 85%; max-width: 320px; border: 2px solid #ff007f; text-align: center; }
    .result-box h2 { color: #ff007f; margin: 0 0 10px 0; }
    #res-rank { font-size: 50px; font-weight: 900; margin: 0; text-shadow: 0 0 20px currentColor; }
    #res-heat { font-size: 24px; color: #ffd700; margin-bottom: 15px; letter-spacing: 2px; }
    .stats { width: 100%; text-align: left; font-size: 14px; margin-bottom: 20px; color: #ddd; border-top: 1px solid #444; padding-top: 10px; }
    .stats td { padding: 4px 0; }
    .stats .val { text-align: right; font-weight: bold; color: #fff; }
  </style>
</head>
<body>

<div id="game-wrapper">
  
  <div id="title-screen" class="screen">
    <h1>Milli Connect</h1>
    <p>- Live Stream Puzzle -</p>
    <div style="margin-bottom: 20px; color: #00f2fe;">HIGH SCORE: <span id="title-high">0</span></div>
    <button class="play-btn" onclick="changeState('PLAYING')">STREAM START</button>
  </div>

  <div id="game-screen" class="screen hidden">
    <div class="header">
      <div class="info-box"><div class="info-label">TIME</div><div class="info-value" id="ui-time">60</div></div>
      <div class="info-box"><div class="info-label">SCORE</div><div class="info-value" id="ui-score">0</div></div>
    </div>
    
    <div class="gauges">
      <div class="gauge-wrap"><div class="gauge-text">FEVER</div><div class="gauge-bar" id="fever-bar"></div></div>
      <div class="gauge-wrap"><div class="gauge-text">COMBO <span id="ui-combo">0</span></div><div class="gauge-bar" id="combo-bar"></div></div>
    </div>

    <div id="canvas-container">
      <div id="fx-layer"><div id="cutin"></div></div>
      <canvas id="game-canvas"></canvas>
    </div>

    <div class="skills">
      <div class="skill-btn" id="skill-btn-0" onclick="activateSkill(0)"><div class="skill-fill" id="skill-fill-0" style="height:0%"></div><div class="skill-text">赤<br>BOMB</div></div>
      <div class="skill-btn" id="skill-btn-1" onclick="activateSkill(1)"><div class="skill-fill" id="skill-fill-1" style="height:0%"></div><div class="skill-text">青<br>TIME</div></div>
      <div class="skill-btn" id="skill-btn-2" onclick="activateSkill(2)"><div class="skill-fill" id="skill-fill-2" style="height:0%"></div><div class="skill-text">緑<br>BOOST</div></div>
    </div>
  </div>

  <div id="result-screen" class="screen hidden">
    <div class="result-box">
      <h2>STREAM END</h2>
      <div id="res-rank">C</div>
      <div id="res-heat">★★★☆☆</div>
      <table class="stats">
        <tr><td>SCORE</td><td class="val" id="res-score">0</td></tr>
        <tr><td>MAX COMBO</td><td class="val" id="res-combo">0</td></tr>
        <tr><td>TOTAL CLEARED</td><td class="val" id="res-cleared">0</td></tr>
        <tr><td>COLLAB BONUS</td><td class="val" id="res-collab">0</td></tr>
      </table>
      <button class="play-btn" onclick="changeState('TITLE')">FINISH</button>
    </div>
  </div>

</div>

<script>
  // ==========================================
  // Web Audio API サウンドシステム
  // ==========================================
  let audioCtx = null;
  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playTone(freq, type = 'sine', duration = 0.1, vol = 0.1) {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(vol, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
  }

  const SOUNDS = {
    connect: (chainLength) => playTone(300 + chainLength * 50, 'sine', 0.1, 0.1),
    pop: () => playTone(800, 'square', 0.1, 0.05),
    bomb: () => playTone(100, 'sawtooth', 0.3, 0.2),
    spacha: () => { playTone(1200, 'sine', 0.1, 0.1); setTimeout(() => playTone(1600, 'sine', 0.3, 0.1), 100); },
    fever: () => { playTone(400, 'square', 0.2, 0.1); setTimeout(() => playTone(600, 'square', 0.4, 0.1), 200); }
  };

  // ==========================================
  // 定数・ゲーム設定
  // ==========================================
  const GAME_TIME = 60;
  const TSUM_RADIUS = 22;
  const MAX_TSUMS = 45;
  const SKILL_MAX = 15; 
  const CONNECT_DIST = TSUM_RADIUS * 2.8;

  const CHARS = [
    { id: 0, name: '赤', color: '#ff2a6d', textColor: '#fff' },
    { id: 1, name: '青', color: '#05d9e8', textColor: '#fff' },
    { id: 2, name: '緑', color: '#00ff87', textColor: '#000' },
    { id: 3, name: '黄', color: '#f1c40f', textColor: '#000' },
    { id: 4, name: '紫', color: '#9b59b6', textColor: '#fff' }
  ];
  
  // 特殊アイテム
  const ITEM_BOMB = { id: 98, name: '★', color: '#ffffff', textColor: '#000' };
  const ITEM_MIC = { id: 99, name: '🎤', color: '#ff007f', textColor: '#fff' };
  const ITEM_SPACHA = { id: 100, name: '￥', color: '#ff0000', textColor: '#fff' }; // 赤スパ（お邪魔兼ボーナス）

  const { Engine, World, Bodies, Vector } = Matter;
  let engine, world;
  let canvas, ctx, canvasW, canvasH;
  
  let state = 'TITLE';
  let reqId = null;
  let timerInterval = null;

  let tsums = [];
  let selected = [];
  let isDragging = false;
  let floatingTexts = []; // ポップアップテキスト用
  
  let score = 0;
  let timeLeft = 0;
  let highScore = localStorage.getItem('milli_connect_hs') || 0;
  
  let combo = 0; let maxCombo = 0; let comboTimer = 0;
  let feverGauge = 0; let isFever = false; let feverTimeLeft = 0;
  let skillGauges = [0, 0, 0]; let scoreMultiplier = 1; let boostTimeLeft = 0;
  let statsCleared = 0; let statsCollab = 0;
  let lastChainId = -1; let lastChainLength = 0;

  // ==========================================
  // 初期化
  // ==========================================
  window.onload = () => {
    document.getElementById('title-high').innerText = Number(highScore).toLocaleString();
    const container = document.getElementById('canvas-container');
    canvas = document.getElementById('game-canvas');
    canvasW = container.clientWidth; canvasH = container.clientHeight;
    canvas.width = canvasW; canvas.height = canvasH;
    ctx = canvas.getContext('2d');

    engine = Engine.create({ gravity: { x: 0, y: 1.2 } });
    world = engine.world;

    const wallOpt = { isStatic: true, friction: 0.1, restitution: 0.2 };
    World.add(world, [
      Bodies.rectangle(canvasW/2, canvasH + 25, canvasW * 2, 50, wallOpt),
      Bodies.rectangle(-25, canvasH/2, 50, canvasH * 2, wallOpt),
      Bodies.rectangle(canvasW + 25, canvasH/2, 50, canvasH * 2, wallOpt)
    ]);

    canvas.addEventListener('mousedown', pointerDown); canvas.addEventListener('mousemove', pointerMove); window.addEventListener('mouseup', pointerUp);
    canvas.addEventListener('touchstart', pointerDown, { passive: false }); canvas.addEventListener('touchmove', pointerMove, { passive: false }); window.addEventListener('touchend', pointerUp);

    gameLoop();
  };

  function changeState(newState) {
    if (newState === 'PLAYING') initAudio(); // ユーザー操作を機にAudio有効化
    
    document.getElementById('title-screen').classList.add('hidden');
    document.getElementById('game-screen').classList.add('hidden');
    document.getElementById('result-screen').classList.add('hidden');
    state = newState;

    if (state === 'TITLE') {
      document.getElementById('title-high').innerText = Number(highScore).toLocaleString();
      document.getElementById('title-screen').classList.remove('hidden');
    } else if (state === 'PLAYING') {
      document.getElementById('game-screen').classList.remove('hidden');
      initGame();
    } else if (state === 'RESULT') {
      showResult();
      document.getElementById('result-screen').classList.remove('hidden');
    }
  }

  function triggerShake(isLarge = false) {
    const container = document.getElementById('canvas-container');
    const shakeClass = isLarge ? 'shake-large' : 'shake-small';
    container.classList.remove('shake-small', 'shake-large');
    void container.offsetWidth; // リフロー強制
    container.classList.add(shakeClass);
    setTimeout(() => container.classList.remove(shakeClass), isLarge ? 500 : 300);
  }

  function addFloatingText(x, y, text, color = '#00f2fe') {
    floatingTexts.push({ x, y, text, color, life: 40 });
  }

  // ==========================================
  // ゲームロジック
  // ==========================================
  function initGame() {
    tsums.forEach(t => World.remove(world, t.body));
    tsums = []; selected = []; floatingTexts = [];
    score = 0; timeLeft = GAME_TIME;
    combo = 0; maxCombo = 0; comboTimer = 0;
    feverGauge = 0; isFever = false; feverTimeLeft = 0;
    skillGauges = [0, 0, 0]; boostTimeLeft = 0;
    statsCleared = 0; statsCollab = 0;
    lastChainId = -1; lastChainLength = 0;
    
    document.getElementById('canvas-container').classList.remove('fever-mode');
    updateUI();
    spawnTsums(MAX_TSUMS);
    showCutin("STREAM START!");
    SOUNDS.fever(); // 開始音代わり

    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      if (state !== 'PLAYING') return;
      timeLeft--;
      if (boostTimeLeft > 0) boostTimeLeft--;
      
      // 赤スパ自然発生（極稀に）
      if (Math.random() < 0.05) spawnTsums(1, ITEM_SPACHA);
      
      if (isFever) {
        feverTimeLeft--; feverGauge = (feverTimeLeft / 10) * 100;
        if (Math.random() < 0.6) spawnComment();
        if (feverTimeLeft <= 0) { isFever = false; feverGauge = 0; document.getElementById('canvas-container').classList.remove('fever-mode'); }
      }
      updateUI();
      if (timeLeft <= 0) changeState('RESULT');
    }, 1000);
  }

  function spawnTsums(count, specificItem = null) {
    for (let i = 0; i < count; i++) {
      const x = Math.random() * (canvasW - TSUM_RADIUS*4) + TSUM_RADIUS*2;
      const y = -Math.random() * 200 - TSUM_RADIUS*2;
      let renderData = specificItem || CHARS[Math.floor(Math.random() * CHARS.length)];
      
      // 赤スパは重く、少し大きくする
      const r = renderData.id === 100 ? TSUM_RADIUS * 1.3 : TSUM_RADIUS;
      const den = renderData.id === 100 ? 0.01 : 0.002; 

      const body = Bodies.circle(x, y, r, { restitution: 0.15, friction: 0.1, density: den });
      tsums.push({ body: body, data: renderData, radius: r });
      World.add(world, body);
    }
  }

  function getPos(e) {
    const rect = canvas.getBoundingClientRect();
    const cx = e.touches ? e.touches[0].clientX : e.clientX;
    const cy = e.touches ? e.touches[0].clientY : e.clientY;
    return { x: (cx - rect.left) * (canvas.width / rect.width), y: (cy - rect.top) * (canvas.height / rect.height) };
  }

  function getHitTsum(pos) {
    return tsums.find(t => Vector.magnitude(Vector.sub(t.body.position, pos)) <= t.radius * 1.2);
  }

  function pointerDown(e) {
    if (state !== 'PLAYING') return; e.preventDefault();
    const hit = getHitTsum(getPos(e));
    if (hit) {
      if (hit.data.id === 100) return; // 赤スパはタップしても何もない
      if (hit.data.id === 98 || hit.data.id === 99) { activateItem(hit); return; }
      isDragging = true; selected = [hit];
      SOUNDS.connect(1);
    }
  }

  function pointerMove(e) {
    if (!isDragging || state !== 'PLAYING' || selected.length === 0) return; e.preventDefault();
    const hit = getHitTsum(getPos(e));
    if (!hit || hit.data.id >= 90) return;

    const last = selected[selected.length - 1];
    const prev = selected[selected.length - 2];
    if (prev && hit === prev) { selected.pop(); return; }

    if (!selected.includes(hit) && hit.data.id === last.data.id) {
      if (Vector.magnitude(Vector.sub(hit.body.position, last.body.position)) <= CONNECT_DIST) {
        selected.push(hit);
        SOUNDS.connect(selected.length); // 繋ぐたびに音が高くなる
      }
    }
  }

  function pointerUp() {
    if (!isDragging) return; isDragging = false;
    const min = isFever ? 2 : 3;
    if (selected.length >= min) processChain(selected);
    selected = [];
  }

  function processChain(chainArray) {
    const count = chainArray.length;
    const charId = chainArray[0].data.id;
    statsCleared += count;
    SOUNDS.pop();

    if (count >= 7 && lastChainLength >= 7 && lastChainId !== charId && lastChainId !== -1) {
      statsCollab++; score += 5000; showCutin("COLLAB BONUS!"); spawnTsums(1, ITEM_MIC);
      SOUNDS.fever(); triggerShake(false);
    }
    lastChainId = charId; lastChainLength = count;

    combo++; if (combo > maxCombo) maxCombo = combo; comboTimer = 100;

    let base = count * 100 + Math.max(0, count - 3) * 150;
    if (count >= 7) base += 500;
    scoreMultiplier = 1 + (combo * 0.05);
    if (isFever) scoreMultiplier *= 1.5;
    if (boostTimeLeft > 0) scoreMultiplier *= 2.0;
    
    const addedScore = Math.floor(base * scoreMultiplier);
    score += addedScore;

    // スコアポップアップ表示
    const lastPos = chainArray[chainArray.length - 1].body.position;
    addFloatingText(lastPos.x, lastPos.y - 20, `+${addedScore}`);

    if (!isFever) {
      feverGauge = Math.min(100, feverGauge + count * 3);
      if (feverGauge >= 100) startFever();
    }
    if (charId >= 0 && charId <= 2) { skillGauges[charId] = Math.min(SKILL_MAX, skillGauges[charId] + count); }

    let spawnItem = null;
    if (count >= 7 && Math.random() > 0.3) spawnItem = ITEM_BOMB;

    removeTsums(chainArray);
    let spawnCount = count;
    if (spawnItem) { spawnTsums(1, spawnItem); spawnCount--; }
    spawnTsums(spawnCount);
    updateUI();
  }

  function removeTsums(arrayToRemove) {
    arrayToRemove.forEach(t => { World.remove(world, t.body); tsums = tsums.filter(ts => ts !== t); });
  }

  function activateItem(tsumItem) {
    const pos = tsumItem.body.position;
    removeTsums([tsumItem]);
    let hits = [];

    if (tsumItem.data.id === 98) { // BOMB
      hits = tsums.filter(t => Vector.magnitude(Vector.sub(t.body.position, pos)) < TSUM_RADIUS * 4.5);
      SOUNDS.bomb(); triggerShake(false); showCutin("BOMB!");
    } else if (tsumItem.data.id === 99) { // MIC
      hits = tsums.filter(t => Math.abs(t.body.position.y - pos.y) < TSUM_RADIUS * 2);
      SOUNDS.bomb(); triggerShake(false); showCutin("MIC ON!");
      if (!isFever) { feverGauge = Math.min(100, feverGauge + 30); if (feverGauge >= 100) startFever(); }
    }

    processExplosionHits(hits, pos);
  }

  // 爆風やスキルで巻き込んだ時の処理（赤スパ判定含む）
  function processExplosionHits(hits, originPos) {
    if (hits.length === 0) { spawnTsums(1); return; }

    let addedScore = 0;
    let hasSpacha = false;

    hits.forEach(t => {
      if (t.data.id === 100) { hasSpacha = true; addedScore += 10000; }
      else { addedScore += Math.floor(150 * scoreMultiplier); statsCleared++; }
    });

    removeTsums(hits);
    score += addedScore;
    addFloatingText(originPos.x, originPos.y, `+${addedScore}`, hasSpacha ? '#ff0000' : '#00f2fe');

    if (hasSpacha) {
      SOUNDS.spacha(); triggerShake(true); showCutin("SUPER CHAT!");
    }

    spawnTsums(hits.length + 1);
    updateUI();
  }

  function startFever() {
    isFever = true; feverTimeLeft = 10; feverGauge = 100;
    document.getElementById('canvas-container').classList.add('fever-mode');
    SOUNDS.fever(); triggerShake(false); showCutin("STREAM FEVER!");
    for(let i=0; i<5; i++) setTimeout(spawnComment, i*300);
  }

  window.activateSkill = function(id) {
    if (state !== 'PLAYING' || skillGauges[id] < SKILL_MAX) return;
    skillGauges[id] = 0; showCutin(CHARS[id].name + " SKILL!"); SOUNDS.fever();
    
    if (id === 0) {
      const center = { x: canvasW/2, y: canvasH/2 + 50 };
      const hits = tsums.filter(t => Vector.magnitude(Vector.sub(t.body.position, center)) < 120);
      triggerShake(true);
      processExplosionHits(hits, center);
    } else if (id === 1) { timeLeft += 5; addFloatingText(canvasW/2, canvasH/2, "TIME +5", "#05d9e8"); }
    else if (id === 2) { boostTimeLeft = 8; addFloatingText(canvasW/2, canvasH/2, "SCORE x2", "#00ff87"); }
    updateUI();
  }

  function updateUI() {
    document.getElementById('ui-score').innerText = score.toLocaleString();
    document.getElementById('ui-time').innerText = timeLeft;
    document.getElementById('ui-combo').innerText = combo;
    document.getElementById('combo-bar').style.width = comboTimer + '%';
    document.getElementById('fever-bar').style.width = Math.min(100, feverGauge) + '%';
    for (let i = 0; i < 3; i++) {
      let pct = (skillGauges[i] / SKILL_MAX) * 100;
      document.getElementById("skill-fill-"+i).style.height = pct + '%';
      let btn = document.getElementById("skill-btn-"+i);
      pct >= 100 ? btn.classList.add('ready') : btn.classList.remove('ready');
    }
  }

  function showCutin(text) {
    const el = document.getElementById('cutin');
    el.innerText = text; el.style.opacity = '1'; el.style.transform = 'translate(-50%, -50%) scale(1.2)';
    setTimeout(() => { el.style.opacity = '0'; el.style.transform = 'translate(-50%, -50%) scale(0)'; }, 1000);
  }

  function spawnComment() {
    const texts = ["草", "888888", "たすかる", "神配信", "きたあああ", "かわいい", "最高", "赤スパないす"];
    const el = document.createElement('div'); el.className = 'comment';
    el.innerText = texts[Math.floor(Math.random() * texts.length)];
    el.style.top = Math.random() * 80 + '%';
    document.getElementById('fx-layer').appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  function showResult() {
    clearInterval(timerInterval);
    if (score > highScore) { highScore = score; localStorage.setItem('milli_connect_hs', highScore); }

    let rank = 'C', color = '#aaa', heat = '★☆☆☆☆';
    if (score >= 150000) { rank = 'S+'; color = '#ff007f'; heat = '★★★★★'; }
    else if (score >= 100000) { rank = 'S'; color = '#ff8c00'; heat = '★★★★☆'; }
    else if (score >= 50000) { rank = 'A'; color = '#00f2fe'; heat = '★★★☆☆'; }
    else if (score >= 20000) { rank = 'B'; color = '#4ecc71'; heat = '★★☆☆☆'; }

    const rRank = document.getElementById('res-rank');
    rRank.innerText = 'RANK ' + rank; rRank.style.color = color;
    document.getElementById('res-heat').innerText = heat;
    document.getElementById('res-score').innerText = score.toLocaleString();
    document.getElementById('res-combo').innerText = maxCombo;
    document.getElementById('res-cleared').innerText = statsCleared;
    document.getElementById('res-collab').innerText = statsCollab;
  }

  function gameLoop() {
    if (state === 'PLAYING') {
      Engine.update(engine, 1000/60);
      if (combo > 0) {
        comboTimer -= 0.6;
        if (comboTimer <= 0) { combo = 0; comboTimer = 0; lastChainId = -1; lastChainLength = 0; updateUI(); }
        else document.getElementById('combo-bar').style.width = comboTimer + '%';
      }
    }

    ctx.clearRect(0, 0, canvasW, canvasH);

    if (state === 'PLAYING') {
      // 接続線
      if (selected.length > 1) {
        ctx.beginPath(); ctx.strokeStyle = selected[0].data.color; ctx.lineWidth = 14; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
        selected.forEach((t, i) => { i === 0 ? ctx.moveTo(t.body.position.x, t.body.position.y) : ctx.lineTo(t.body.position.x, t.body.position.y); });
        ctx.stroke();
        ctx.beginPath(); ctx.strokeStyle = '#fff'; ctx.lineWidth = 4;
        selected.forEach((t, i) => { i === 0 ? ctx.moveTo(t.body.position.x, t.body.position.y) : ctx.lineTo(t.body.position.x, t.body.position.y); });
        ctx.stroke();
      }

      // ツム描画
      tsums.forEach(t => {
        const {x, y} = t.body.position; const angle = t.body.angle;
        const isSel = selected.includes(t);
        const r = isSel ? t.radius * 1.15 : t.radius;

        ctx.save(); ctx.translate(x, y); ctx.rotate(angle);
        
        ctx.beginPath();
        if (t.data.id === 100) {
          // 赤スパは少し四角っぽい表現にする（丸角矩形風）
          ctx.roundRect ? ctx.roundRect(-r, -r, r*2, r*2, 10) : ctx.arc(0, 0, r, 0, Math.PI * 2);
        } else {
          ctx.arc(0, 0, r, 0, Math.PI * 2);
        }

        ctx.fillStyle = t.data.color;
        if (isSel || t.data.id >= 90) { ctx.shadowColor = t.data.id === 100 ? '#ff0000' : '#fff'; ctx.shadowBlur = 15; }
        ctx.fill(); ctx.shadowBlur = 0;
        
        ctx.lineWidth = 2; ctx.strokeStyle = t.data.id === 100 ? '#ffd700' : '#fff'; ctx.stroke();
        
        ctx.fillStyle = t.data.textColor;
        ctx.font = t.data.id === 100 ? 'bold 20px sans-serif' : 'bold 12px sans-serif'; 
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(t.data.name, 0, 0);
        ctx.restore();
      });

      // スコアポップアップ描画
      floatingTexts.forEach(ft => {
        ft.life--; ft.y -= 1;
        ctx.save();
        ctx.globalAlpha = Math.max(0, ft.life / 40);
        ctx.fillStyle = ft.color;
        ctx.font = 'bold 20px sans-serif';
        ctx.shadowColor = '#000'; ctx.shadowBlur = 4;
        ctx.textAlign = 'center'; ctx.fillText(ft.text, ft.x, ft.y);
        ctx.restore();
      });
      floatingTexts = floatingTexts.filter(ft => ft.life > 0);
    }

    reqId = requestAnimationFrame(gameLoop);
  }
</script>
